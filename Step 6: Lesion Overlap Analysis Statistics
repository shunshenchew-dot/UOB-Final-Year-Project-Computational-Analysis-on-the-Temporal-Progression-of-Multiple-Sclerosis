        ax.xaxis.set_major_formatter(FormatStrFormatter("%d"))

    for k in range(len(axes)):
        if k not in plotted_axes:
            fig.delaxes(axes[k])
            fig.suptitle(title, fontsize=48, fontweight="bold", y=0.992)

    handles, labels = [], []
    seen = set()

    for ax_idx in plotted_axes:
        h, l = axes[ax_idx].get_legend_handles_labels()
        for hh, ll in zip(h, l):
            if ll not in seen:
                handles.append(hh)
                labels.append(ll)
                seen.add(ll)

    if handles:
        ncol_legend = 5 if len(labels) >= 10 else max(1, len(labels))
        fig.legend(
            handles,
            labels,
            loc="upper center",
            bbox_to_anchor=(0.5, 0.972),
            ncol=ncol_legend,
            frameon=False,
            fontsize=28
        )

    fig.tight_layout(
        rect=[0.02, 0.02, 0.98, 0.982],
        pad=0.2,
        h_pad=0.6,
        w_pad=0.8
    )

    fig.savefig(
        FIG_ESSENTIAL / outname,
        dpi=300,
        bbox_inches="tight",
        pad_inches=0.005
    )
    plt.close(fig)
    print(f"Saved plot: {outname}")

