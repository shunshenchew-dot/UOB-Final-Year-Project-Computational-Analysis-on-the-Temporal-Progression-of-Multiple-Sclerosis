def format_x_label(val):
    """Removes all hyphens and newlines to create clean, single-line labels."""
    lbl = short_label(val)
    # Fix hyphenated splits like "Cere-\nbellum" -> "Cerebellum"
    lbl = lbl.replace("-\n", "")
    # Strip any remaining hyphens and line breaks
    lbl = lbl.replace("-", "").replace("\n", " ")
    return lbl

