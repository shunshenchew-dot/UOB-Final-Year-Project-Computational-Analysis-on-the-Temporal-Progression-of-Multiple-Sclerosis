def generate_side_by_side_volume_variability(df_long, outname):
    # Set up a 1x2 side-by-side figure layout
    fig, axes = plt.subplots(1, 2, figsize=(40, 12), layout="constrained")

    # Define our splits, titles, bar colors, and panel labels
    splits = [
        ("TRAIN", "Training set Inter-rater Variability (Expert V1 and V2)", "royalblue", "lightsteelblue", 0, "a)"),
        ("TEST", "Testing set Inter-rater Variability (Expert V1 and V2)", "firebrick", "lightcoral", 1, "b)")
    ]

    # Use the established region order, excluding Background and Unclassified
    order = [x for x in PLOT_REGION_ORDER if x not in ["Background", "Other / Unclassified Labels"]]

    for split_id, title, c1, c2, col_idx, panel_label in splits:
        ax = axes[col_idx]
        
        # Filter for the current split
        d_split = df_long[df_long["split"] == split_id]
        
        # Calculate the mean lesion volume (overlap_mm3) for each rater per region
        v1_data = d_split[d_split["rater"] == "Expert_V1"].groupby("region_name")["overlap_mm3"].mean().reindex(order).reset_index()
        v2_data = d_split[d_split["rater"] == "Expert_V2"].groupby("region_name")["overlap_mm3"].mean().reindex(order).reset_index()

        # Set up X-axis positioning
        x = np.arange(len(order))
        w = 0.39
        tick_labels = [short_label(reg) for reg in order]

        # Plot bars
        ax.bar(x - w / 2, v1_data["overlap_mm3"], width=w, color=c1, edgecolor="black", label="Expert V1")
        ax.bar(x + w / 2, v2_data["overlap_mm3"], width=w, color=c2, edgecolor="black", label="Expert V2")

        # Add the 'a)' and 'b)' panel labels to the top left corner
        ax.text(-0.06, 1.12, panel_label, transform=ax.transAxes, fontsize=50, fontweight='bold', fontfamily='serif', va='bottom', ha='right')

        # Apply the captions and formatting
        ax.set_title(title, pad=15, fontsize=45)
        ax.set_ylabel("Total lesion volume (mm³)", labelpad=15)
        ax.set_xlabel("Brain region", labelpad=10)

        ax.set_xticks(x)
        ax.set_xticklabels(tick_labels, rotation=0, ha="center")
        
        # DOWNSIZED X-AXIS LABELS BY 2 MORE POINTS (33)
        ax.tick_params(axis="x", labelsize=33, pad=5)

        # Styling adjustments
        ax.legend(frameon=False, loc="upper right")
        ax.grid(axis="y", linestyle="--", alpha=0.45)
        ax.set_xlim(-0.55, len(order) - 0.45)

    # Save to the essential outputs folder
    save_compact(fig, FIG_ESSENTIAL / outname)
    plt.close(fig)
    print(f"Saved side-by-side volume plot: {outname}")

