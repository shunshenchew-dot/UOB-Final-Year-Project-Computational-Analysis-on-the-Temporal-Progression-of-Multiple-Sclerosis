def plot_subject_time(subj, tp, include_background=False):
    d = df[(df["subject"] == subj) & (df["timepoint"] == tp)].copy()
    if d.empty:
        return

    d = d[d["region_name"] != "Other / Unclassified Labels"].copy()

    if not include_background:
        d = d[d["region_name"] != "Background"].copy()

    order = [x for x in PLOT_REGION_ORDER.copy() if x != "Other / Unclassified Labels"]
    if not include_background:
        order = [x for x in order if x != "Background"]

    piv = d.pivot_table(
        index="region_name",
        columns="rater",
        values="overlap_mm3",
        aggfunc="first"
    ).fillna(0)

    piv = piv.reindex(order)

    x = np.arange(len(piv.index))
    w = 0.42
    tick_labels = [short_label(x) for x in piv.index]

    fig, ax = plt.subplots(figsize=(21, 12))

    ax.bar(x - w / 2, piv.get("Expert_V1", 0), width=w, label="Expert V1", edgecolor="black")
    ax.bar(x + w / 2, piv.get("Expert_V2", 0), width=w, label="Expert V2", edgecolor="black")

    ax.set_xticks(x)
    ax.set_xticklabels(tick_labels, rotation=0, ha="center")
    ax.tick_params(axis="x", pad=1)

    ax.set_title(f"{subj} {tp} — Lesion overlap per region", pad=5)
    ax.set_ylabel("Lesion overlap volume (mm³)", labelpad=5)
    ax.set_xlabel("Brain region", labelpad=4)

    ax.legend(frameon=False, loc="upper right")
    ax.grid(axis="y", linestyle="--", alpha=0.45)

    clean_bar_layout(fig, ax, n_bars=len(piv.index))
    save_compact(fig, FIG_OTHER / f"{subj}_{tp}_overlap_mm3_V1_vs_V2.png")

    plt.close(fig)


